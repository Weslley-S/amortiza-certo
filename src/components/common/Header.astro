---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Calculadora Geral' },
  { href: '/tabela-sac-vs-price', label: 'SAC vs. Price' },
  { href: '/amortizar-prazo-ou-parcela', label: 'Prazo ou Parcela?' },
  { href: '/amortizar-com-fgts', label: 'Amortizar com FGTS' },
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class="bg-white border-b border-slate-200 sticky top-0 z-30 print:hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
    <a
      href="/"
      class="flex items-center gap-2.5 text-slate-900 font-bold text-lg tracking-tight hover:text-emerald-700 transition-colors"
    >
      <img src="/favicon.svg" alt="" width="28" height="28" class="w-7 h-7 rounded-md shrink-0" />
      <span>Calculadora de Amortização</span>
    </a>

    <nav aria-label="Navegação principal" class="flex flex-wrap items-center gap-1.5 sm:gap-2">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-colors ${
              isActive(link.href)
                ? 'bg-emerald-50 text-emerald-800 border border-emerald-200'
                : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'
            }`}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
